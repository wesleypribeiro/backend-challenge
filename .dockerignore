# Somente entradas necessárias ao build podem entrar no contexto.
**
!Dockerfile
!package.json
!bun.lock
!bunfig.toml
!.bun-version
!tsconfig.json
!tsconfig.build.json
!scripts/
!scripts/build.ts
!src/
!src/**/
!src/**/*.ts
!patches/
!patches/*.patch
# Inclui automaticamente futuras migrations TypeScript sob src/platform/database/migrations/.
# Bootstrap PostgreSQL é montado pelo Compose; docker/ e scripts de teste não entram na imagem da aplicação.
# Ao adicionar runners necessários à imagem, liberar seus caminhos explicitamente acima.
# Defesa adicional para arquivos locais sob src/.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/secrets/**
**/.aws/**
**/node_modules/**
**/*.log
