# Somente desenvolvimento local. Não usar credenciais reais.
# NODE_ENV=production seleciona o runtime compilado, não habilita AWS real.
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://wagering_app:local_app_password@localhost:5432/wagering
# Somente no ambiente do migrator; nunca exportar para API/worker:
# MIGRATION_DATABASE_URL=postgresql://wagering_migrator:local_migrator_password@localhost:5432/wagering
PG_POOL_MAX=5
PG_CONNECT_TIMEOUT_MS=1000
PG_QUERY_TIMEOUT_MS=1000
SHUTDOWN_TIMEOUT_MS=25000

# No Docker, usar http://localstack:4566 e host PostgreSQL postgres.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_REQUEST_TIMEOUT_MS=25000
SQS_MAX_ATTEMPTS=3
